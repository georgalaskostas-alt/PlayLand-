    "quest.uncoverFoxSecret.desc": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprich mit Alepou und finde heraus, warum sie wirklich die Vorräte gesammelt hat."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μίλησε στην Αλεπού και ανακάλυψε γιατί πραγματικά μάζεψε τις προμήθειες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Talk to Alepou and discover why she really gathered the supplies."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Habla con Alepou y descubre por qué realmente reunió las provisiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parle à Alepou et découvre pourquoi elle a vraiment rassemblé les provisions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parla con Alepou e scopri perché ha davvero raccolto le provviste."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fale com Alepou e descubra por que ela realmente reuniu os suprimentos."
          }
        }
      }
    },
    "campaign.lostForestSupplies.title": {
      "localizations": {
        "de": {
