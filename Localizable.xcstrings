    "campaign.lostForestSupplies.desc": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hilf Babis und Kotsifi, den Dorfkorb wieder zu füllen und ein Waldgeheimnis zu lüften."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βοήθησε τον Μπάμπη και τον Κοτσίφι να γεμίσουν ξανά το καλάθι του χωριού και να λύσουν ένα μυστήριο του δάσους."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Help Babis and Kotsifi refill the village basket and uncover a forest mystery."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayuda a Babis y Kotsifi a llenar la cesta del pueblo y descubrir un misterio del bosque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aide Babis et Kotsifi à remplir le panier du village et à percer un mystère de la forêt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aiuta Babis e Kotsifi a riempire il cesto del villaggio e a svelare un mistero della foresta."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajude Babis e Kotsifi a reabastecer a cesta da vila e desvendar um mistério da floresta."
          }
        }
      }
    },
