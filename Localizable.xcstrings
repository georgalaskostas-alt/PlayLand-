    "dino.farm.completeMessage": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast es geschafft! Du hast Babis genau beobachtet und herausgefunden, was er alles brauchte!"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα κατάφερες! Παρατήρησες προσεκτικά τον Μπάμπη και βρήκες όλα όσα χρειαζόταν!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You did it! You watched Babis carefully and figured out everything he needed!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Lo lograste! Observaste a Babis con atención y descubriste todo lo que necesitaba!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as réussi ! Tu as bien observé Babis et découvert tout ce dont il avait besoin !"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce l'hai fatta! Hai osservato Babis con attenzione e capito tutto ciò di cui aveva bisogno!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Conseguiste! Observaste o Babis com atenção e descobriste tudo o que ele precisava!"
          }
        }
      }
    },
