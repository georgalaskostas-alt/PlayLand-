    "quest.findCave.desc": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erkunde den Wald und finde den Eingang zur Kristallhöhle."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
