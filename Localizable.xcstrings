    "quest.gatherSupplies.desc": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finde Essen und sauberes Wasser für den Dorfkorb."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βρες φαγητό και καθαρό νερό για το καλάθι του χωριού."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find food and clean water for the village basket."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra comida y agua limpia para la cesta del pueblo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouve de la nourriture et de l'eau propre pour le panier du village."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova cibo e acqua pulita per il cesto del villaggio."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontre comida e água limpa para a cesta da vila."
          }
        }
      }
    },
