          "stringUnit": {
            "state": "translated",
            "value": "Explore the forest and find the entrance to the Crystal Cave."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Explora el bosque y encuentra la entrada a la Cueva de Cristal."
          }
        },
