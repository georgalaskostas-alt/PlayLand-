    "dino.farm.desc" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Füttere und pflege Babis!" } },
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Φρόντισε τον Μπάμπη!" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Feed and care for Babis!" } },
