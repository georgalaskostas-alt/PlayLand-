    "dino.farm.instruction" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Babis ist hungrig und einsam. Füttere, wasche und spiele mit ihm, bis er glücklich ist!" } },
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Ο Μπάμπης πεινάει και είναι μόνος. Τάισέ τον, καθάρισέ τον και παίξε μαζί του μέχρι να χαρεί!" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Babis is hungry and lonely. Feed, clean and play with him until he's happy!" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Babis tiene hambre y está solo. ¡Aliméntalo, límpialo y juega con él hasta que esté feliz!" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Babis a faim et se sent seul. Nourris-le, lave-le et joue avec lui jusqu'à ce qu'il soit heureux !" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Babis ha fame ed è solo. Nutrilo, lavalo e gioca con lui finché non è felice!" } },
        "pt" : { "stringUnit" : { "state" : "translated", "value" : "O Babis está com fome e sozinho. Alimenta-o, limpa-o e brinca com ele até ele ficar feliz!" } }
      }
    },
