    "adventure.explore.tree": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist eine alte Eiche. Sie spendet Schatten und leckere Früchte!"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή είναι μια γέρικη βελανιδιά. Δίνει σκιά και νόστιμους καρπούς!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is an old oak tree. It gives shade and yummy fruit!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este es un viejo roble. ¡Da sombra y frutos deliciosos!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est un vieux chêne. Il donne de l'ombre et de délicieux fruits !"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa è una vecchia quercia. Dà ombra e frutti deliziosi!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este é um velho carvalho. Dá sombra e frutos deliciosos!"
          }
        }
      }
    },
    "adventure.explore.rock": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein glänzender Stein! Vielleicht sind darunter Kristalle versteckt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια γυαλιστερή πέτρα! Μπορεί να κρύβει κρύσταλλα από κάτω."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A shiny rock! Maybe there are crystals hiding underneath."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Una roca brillante! Quizás haya cristales escondidos debajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rocher brillant ! Il y a peut-être des cristaux cachés en dessous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una roccia luccicante! Forse ci sono cristalli nascosti sotto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma pedra brilhante! Talvez haja cristais escondidos por baixo."
          }
        }
      }
    },
