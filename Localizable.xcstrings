    "dialogue.village.berries": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Φρέσκα μούρα! Ιδανικά για το καλάθι."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fresh berries! Perfect for the basket."
          }
        }
      }
