    "dialogue.village.kotsifi.line0": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Γεια σου Μπάμπη! Σε περιμένω όλο το πρωί!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi Babis! I've been waiting for you all morning!"
          }
        }
      }
    },
    "dialogue.village.kotsifi.line1": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάμε για εξερεύνηση μαζί — το δάσος σίγουρα κρύβει εκπλήξεις για μας!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let's go exploring together — I bet the forest has surprises for us!"
          }
        }
      }
    },
    "dialogue.village.flowers": {
      "localizations": {
