    "quest.meetKotsifi.title" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Finde Kotsifi" } },
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Βρες τον Κότσιφα" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Find Kotsifi" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Encuentra a Kotsifi" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Trouve Kotsifi" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Trova Kotsifi" } },
        "pt" : { "stringUnit" : { "state" : "translated", "value" : "Encontra o Kotsifi" } }
      }
    },
    "quest.meetKotsifi.desc" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Erkunde das Dorf und begrüße Kotsifi." } },
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Εξερεύνησε το χωριό και χαιρέτησε τον Κότσιφα." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Explore the village and say hello to Kotsifi." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Explora la aldea y saluda a Kotsifi." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Explore le village et dis bonjour à Kotsifi." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Esplora il villaggio e saluta Kotsifi." } },
        "pt" : { "stringUnit" : { "state" : "translated", "value" : "Explora a aldeia e cumprimenta o Kotsifi." } }
      }
    },
    "quest.findCave.title" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Entdecke den Höhleneingang" } },
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Ανακάλυψε την είσοδο της σπηλιάς" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Discover the Cave Entrance" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Descubre la entrada de la cueva" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Découvre l'entrée de la grotte" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Scopri l'ingresso della grotta" } },
        "pt" : { "stringUnit" : { "state" : "translated", "value" : "Descobre a entrada da caverna" } }
      }
    },
    "quest.findCave.desc" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Erkunde den Wald und finde den Eingang zur Kristallhöhle." } },
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Εξερεύνησε το δάσος και βρες την είσοδο της Σπηλιάς των Κρυστάλλων." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Explore the forest and find the entrance to the Crystal Cave." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Explora el bosque y encuentra la entrada a la Cueva de Cristal." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Explore la forêt et trouve l'entrée de la Grotte de Cristal." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Esplora la foresta e trova l'ingresso della Grotta di Cristallo." } },
        "pt" : { "stringUnit" : { "state" : "translated", "value" : "Explora a floresta e encontra a entrada da Caverna de Cristal." } }
      }
    },
    "quest.collectStones.title" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Sammle 3 glänzende Steine" } },
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Μάζεψε 3 γυαλιστερές πέτρες" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Collect 3 Shiny Stones" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Recoge 3 piedras brillantes" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ramasse 3 pierres brillantes" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Raccogli 3 pietre luccicanti" } },
        "pt" : { "stringUnit" : { "state" : "translated", "value" : "Recolhe 3 pedras brilhantes" } }
      }
    },
    "quest.collectStones.desc" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Durchsuche die Kristallhöhle nach 3 funkelnden Steinen." } },
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Ψάξε στη Σπηλιά των Κρυστάλλων για 3 αστραφτερές πέτρες." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Search the Crystal Cave for 3 sparkling stones." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Busca 3 piedras centelleantes en la Cueva de Cristal." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Cherche 3 pierres scintillantes dans la Grotte de Cristal." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Cerca 3 pietre scintillanti nella Grotta di Cristallo." } },
        "pt" : { "stringUnit" : { "state" : "translated", "value" : "Procura 3 pedras cintilantes na Caverna de Cristal." } }
      }
    },

    "dialogue.village.kotsifi.line0" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Γεια σου Μπάμπη! Σε περιμένω όλο το πρωί!" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Hi Babis! I've been waiting for you all morning!" } }
      }
    },
    "dialogue.village.kotsifi.line1" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Πάμε για εξερεύνηση μαζί — το δάσος σίγουρα κρύβει εκπλήξεις για μας!" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Let's go exploring together — I bet the forest has surprises for us!" } }
      }
    },
    "dialogue.village.flowers" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Αυτά τα λουλούδια μυρίζουν υπέροχα. Τις αγαπούν και οι μέλισσες!" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "These flowers smell wonderful. Bees love them too!" } }
      }
    },
    "dialogue.forest.footprints" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Περίεργα ίχνη... οδηγούν βαθύτερα στο δάσος!" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Strange footprints... they lead deeper into the forest!" } }
      }
    },
    "dialogue.forest.caveEntrance" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Μια είσοδος σπηλιάς! Να ρίξουμε μια ματιά μέσα;" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "A cave entrance! Should we take a look inside?" } }
      }
    },
    "dialogue.cave.stone" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Μια γυαλιστερή πέτρα! Λάμπει σαν μικρό αστέρι." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "A shiny stone! It sparkles like a tiny star." } }
      }
    }
  },
  "version" : "1.0"
