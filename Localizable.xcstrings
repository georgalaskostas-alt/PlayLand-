          }
        }
      }
    },
    "dino.farm.instruction": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Babis braucht deine Hilfe! Sieh ihn dir genau an. Was, glaubst du, braucht er?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο Μπάμπης χρειάζεται τη βοήθειά σου! Κοίταξέ τον προσεκτικά. Τι νομίζεις ότι χρειάζεται;"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Babis needs your help! Look at him carefully. What do you think he needs?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Babis necesita tu ayuda! Míralo con atención. ¿Qué crees que necesita?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Babis a besoin de ton aide ! Regarde-le attentivement. Que penses-tu qu'il lui faut ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Babis ha bisogno del tuo aiuto! Guardalo attentamente. Cosa pensi che gli serva?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Babis precisa da tua ajuda! Olha bem para ele. O que achas que ele precisa?"
          }
        }
      }
    },
