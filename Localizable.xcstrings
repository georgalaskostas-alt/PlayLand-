    "quest.openFirstChest.desc": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewinne die Gedächtnis-Herausforderung, um Kotsifis geheimnisvolle Truhe zu öffnen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κέρδισε το παιχνίδι μνήμης για να ανοίξεις το μυστηριώδες σεντούκι του Κοτσίφι."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Win the memory challenge to open Kotsifi's mysterious chest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gana el desafío de memoria para abrir el misterioso cofre de Kotsifi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagne le défi de mémoire pour ouvrir le mystérieux coffre de Kotsifi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vinci la sfida della memoria per aprire il misterioso baule di Kotsifi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vença o desafio de memória para abrir o baú misterioso do Kotsifi."
          }
        }
      }
    },
