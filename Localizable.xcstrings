    "story.babisKotsifi.title" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Ο Μπάμπης & ο Κότσιφας" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Babis & Kotsifi" } }
      }
    },
    "story.babisKotsifi.desc" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Ένας πεινασμένος δεινόσαυρος κι ένα μικρό πουλί γίνονται οι καλύτεροι φίλοι." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "A hungry dinosaur and a tiny bird become the best of friends." } }
      }
    },
    "story.babisKotsifi.scene0.narration" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Ο Μπάμπης ο δεινόσαυρος ξύπνησε πεινασμένος. Ξαφνικά άκουσε ένα τιτίβισμα να έρχεται από τους θάμνους!" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Babis the dinosaur woke up hungry. Suddenly he heard a little chirp coming from the bushes!" } }
      }
    },
    "story.babisKotsifi.scene0.choice0" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Ακολούθησε τον ήχο" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Follow the chirping sound" } }
      }
    },
    "story.babisKotsifi.scene0.choice1" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Ψάξε πρώτα για μούρα" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Look for berries first" } }
      }
    },
    "story.babisKotsifi.scene1.narration" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Ο Μπάμπης άνοιξε τα φύλλα και βρήκε τον Κότσιφα μπερδεμένο σε ένα κλαδί, να φωνάζει για βοήθεια!" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Babis pushed the leaves aside and found Kotsifi the bird, tangled in a branch and tweeting for help!" } }
      }
    },
    "story.babisKotsifi.scene1.choice0" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Βοήθησε αμέσως τον Κότσιφα" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Help Kotsifi right away" } }
      }
    },
    "story.babisKotsifi.scene2.narration" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Ο Μπάμπης έτρωγε γλυκά μούρα. Όμως το τιτίβισμα γινόταν όλο και πιο δυνατό και κοντινό..." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Babis munched on some sweet berries. But that little chirp kept getting louder and closer..." } }
      }
    },
    "story.babisKotsifi.scene2.choice0" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Πήγαινε να δεις τι είναι ο ήχος" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Go check on the sound" } }
      }
    },
    "story.babisKotsifi.scene3.narration" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Με τον μακρύ του λαιμό, ο Μπάμπης ελευθέρωσε απαλά τον Κότσιφα. Το πουλάκι τιτίβισε χαρούμενα και κάθισε στη μύτη του!" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "With his long neck, Babis gently freed Kotsifi. The little bird chirped happily and landed right on his nose!" } }
      }
    },
    "story.babisKotsifi.scene3.choice0" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Γίνετε κολλητοί φίλοι" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Become best friends" } }
      }
    },
    "story.babisKotsifi.scene4.narration" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Από εκείνη τη μέρα, ο Μπάμπης και ο Κότσιφας εξερευνούσαν μαζί κάθε γωνιά του δάσους. Τέλος!" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "From that day on, Babis and Kotsifi explored every corner of the forest together. The End!" } }
      }
    },

    "story.caveCrystals.title" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Η Σπηλιά με τους Κρυστάλλους" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The Cave of Crystals" } }
      }
    },
    "story.caveCrystals.desc" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Ο Μπάμπης και ο Κότσιφας ανακαλύπτουν μια αστραφτερή σπηλιά — και κάποιον απροσδόκητο μέσα." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Babis and Kotsifi discover a sparkling cave — and someone unexpected inside." } }
      }
    },
    "story.caveCrystals.scene0.narration" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Καθώς εξερευνούσαν, ο Μπάμπης και ο Κότσιφας βρήκαν μια σκοτεινή είσοδο σπηλιάς να λάμπει με ένα περίεργο φως." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "While exploring, Babis and Kotsifi found a dark cave entrance glowing with a strange light." } }
      }
    },
    "story.caveCrystals.scene0.choice0" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Κρυφοκοίταξε με θάρρος" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Peek inside bravely" } }
      }
    },
    "story.caveCrystals.scene0.choice1" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Φώναξε πρώτα" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Call out first" } }
      }
    },
    "story.caveCrystals.scene1.narration" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Μέσα, οι τοίχοι άστραφταν με όμορφους κρυστάλλους. Τότε ένας θόρυβος αντήχησε από πιο βαθιά στη σπηλιά!" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Inside, the walls sparkled with beautiful crystals. Then a rustling sound echoed from deeper in the cave!" } }
      }
    },
    "story.caveCrystals.scene1.choice0" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Ακολούθησε τον ήχο" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Follow the sound" } }
      }
    },
    "story.caveCrystals.scene2.narration" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "«Είναι κανείς εκεί;» φώναξε ο Μπάμπης. Η φωνή του αντήχησε στους κρυστάλλινους τοίχους, και κάτι θρόισε πίσω σαν απάντηση." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "\"Hello?\" called Babis. His voice echoed off the crystal walls, and something rustled back in reply." } }
      }
    },
    "story.caveCrystals.scene2.choice0" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Μπείτε μαζί" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Walk in together" } }
      }
    },
    "story.caveCrystals.scene3.narration" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Ήταν η Αλεπού, μόνη και λίγο φοβισμένη. «Χάθηκα κυνηγώντας πυγολαμπίδες», παραδέχτηκε." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "It was Alepou the fox, all alone and a little scared. \"I got lost chasing fireflies,\" she admitted." } }
      }
    },
    "story.caveCrystals.scene3.choice0" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Πρόσφερε να τη βοηθήσεις να γυρίσει σπίτι" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Offer to help her home" } }
      }
    },
    "story.caveCrystals.scene4.narration" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Ο Μπάμπης και ο Κότσιφας συνόδεψαν την Αλεπού σπίτι με ασφάλεια. Δεν ήταν τόσο τρομακτική τελικά — απλώς μια νέα φίλη! Τέλος!" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Babis and Kotsifi walked Alepou safely home. She wasn't so scary after all — just a new friend! The End!" } }
      }
    },

    "story.forestHero.title" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Ο Φύλακας της Νύχτας" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The Night Guardian" } }
      }
    },
    "story.forestHero.desc" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Όταν πέφτει η νύχτα στο δάσος, ο Μπάμπης μαθαίνει τι σημαίνει να είσαι ήρωας." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "When night falls over the forest, Babis learns what it means to be a hero." } }
      }
    },
    "story.forestHero.scene0.narration" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Ο ήλιος έδυσε και το δάσος σκοτείνιασε. Ο Μπάμπης άκουσε τα μικρά ζωάκια να κλαψουρίζουν, φοβισμένα από τις σκιές." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The sun went down and the forest grew dark. Babis heard the little animals whimpering, afraid of the shadows." } }
      }
    },
    "story.forestHero.scene0.choice0" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Παρηγόρησε τα ζωάκια" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Comfort the animals" } }
      }
    },
    "story.forestHero.scene0.choice1" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Ψάξε την αιτία του φόβου" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Search for the source of fear" } }
      }
    },
    "story.forestHero.scene1.narration" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "«Μην ανησυχείτε», είπε τρυφερά ο Μπάμπης, και ο Κότσιφας τραγούδησε ένα απαλό τραγούδι για να τα ηρεμήσει." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "\"Don't worry,\" Babis said gently, and Kotsifi sang a soft song to calm everyone down." } }
      }
    },
    "story.forestHero.scene1.choice0" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Πήγαινε να βρεις τι τα τρόμαξε" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Go find what scared them" } }
      }
    },
    "story.forestHero.scene2.narration" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Ήταν μόνο η Αλεπού, που έριχνε μεγάλη σκιά καθώς έψαχνε τον δρόμο για το σπίτι της στο σκοτάδι." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "It was only Alepou, casting a big shadow while looking for her way home in the dark." } }
      }
    },
    "story.forestHero.scene2.choice0" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Φωτίστε τον δρόμο μαζί" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Light the way together" } }
      }
    },
    "story.forestHero.scene3.narration" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Ο Μπάμπης προχώρησε μπροστά ώστε όλοι να μπορούν να ακολουθήσουν τη σιλουέτα του με ασφάλεια μέσα στο σκοτεινό δάσος." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Babis walked ahead so everyone could follow his silhouette safely home through the dark forest." } }
      }
    },
    "story.forestHero.scene3.choice0" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Γιορτάστε στο χωριό" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Celebrate in the village" } }
      }
    },
    "story.forestHero.scene4.narration" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Όλο το χωριό πανηγύρισε για τον Μπάμπη, τον δικό τους Φύλακα της Νύχτας του δάσους. Τέλος!" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The whole village cheered for Babis, the forest's very own Night Guardian. The End!" } }
      }
    },

    "chapter.meetingBabis.title" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Γνωρίζοντας τον Μπάμπη" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Meeting Babis" } }
      }
    },
    "chapter.meetingBabis.desc" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Πες γεια στον πιο φιλικό δεινόσαυρο του δάσους." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Say hello to the friendliest dinosaur in the forest." } }
      }
    },
    "chapter.meetingBabis.scene0.narration" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Βαθιά σε ένα ηλιόλουστο δάσος ζούσε ένας μεγάλος, καλόκαρδος δεινόσαυρος ονόματι Μπάμπης, που λάτρευε να εξερευνά." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Deep in a sunny forest lived a big, gentle dinosaur named Babis, who loved to explore." } }
      }
    },
    "chapter.meetingBabis.scene0.choice0" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Χαιρέτησε τον Μπάμπη" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Wave hello to Babis" } }
      }
    },
    "chapter.meetingBabis.scene1.narration" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Ο Μπάμπης χαμογέλασε με όλο του το πρόσωπο και έβγαλε έναν φιλικό βρυχηθμό. «Ένας νέος φίλος!» σκέφτηκε." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Babis smiled with his whole face and let out a friendly rumble. \"A new friend!\" he thought." } }
      }
    },

    "chapter.kotsifiArrives.title" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Ο Κότσιφας Φτάνει" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Kotsifi Arrives" } }
      }
    },
    "chapter.kotsifiArrives.desc" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Ένα μικρό πουλί προσγειώνεται στη μύτη του Μπάμπη." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "A tiny bird lands right on Babis' nose." } }
      }
    },
    "chapter.kotsifiArrives.scene0.narration" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Ένα αεράτο πρωινό, ένα μικρό πουλί ήρθε φτερουγίζοντας από τα δέντρα." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "One breezy morning, a small bird came fluttering down from the trees." } }
      }
    },
    "chapter.kotsifiArrives.scene0.choice0" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Άφησε το πουλί να προσγειωθεί" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Let the bird land" } }
      }
    },
    "chapter.kotsifiArrives.scene1.narration" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Ο Κότσιφας προσγειώθηκε ακριβώς στη μύτη του Μπάμπη και τιτίβισε έναν χαρούμενο σκοπό. Μια νέα φιλία μόλις γεννήθηκε!" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Kotsifi landed right on Babis' nose and chirped a cheerful tune. A new friendship had begun!" } }
      }
    },

    "chapter.cleverFox.title" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Η Έξυπνη Αλεπού" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The Clever Fox" } }
      }
    },
    "chapter.cleverFox.desc" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Μια άτακτη αλεπού ετοιμάζει ένα κόλπο." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "A mischievous fox has a trick up her sleeve." } }
      }
    },
    "chapter.cleverFox.scene0.narration" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Κοντά στη σπηλιά της, η Αλεπού λάτρευε να κάνει φάρσες σε όποιον περνούσε." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Near her cave, Alepou the fox loved playing tricks on anyone who passed by." } }
      }
    },
    "chapter.cleverFox.scene0.choice0" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Πλησίασε προσεκτικά" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Approach carefully" } }
      }
    },
    "chapter.cleverFox.scene0.choice1" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Χαιρέτησε δυνατά" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Say hello loudly" } }
      }
    },
    "chapter.cleverFox.scene1.narration" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Η Αλεπού χαμογέλασε πονηρά, αλλά όταν ο Μπάμπης απλώς της χαμογέλασε ευγενικά, αποφάσισε πως ένας νέος φίλος είναι πιο διασκεδαστικός από μια φάρσα." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Alepou grinned, but when Babis just smiled kindly back, she decided a new friend was more fun than a trick." } }
      }
    },

    "chapter.forestHero.title" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Ήρωας του Δάσους" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Forest Hero" } }
      }
    },
    "chapter.forestHero.desc" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Ο Μπάμπης βοηθά τους φίλους του και γίνεται ο ήρωας του δάσους." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Babis helps his friends and becomes the forest's hero." } }
      }
    },
    "chapter.forestHero.scene0.narration" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Όταν έπεσε η νύχτα και τα μικρά ζωάκια φοβήθηκαν, ο Μπάμπης οδήγησε όλους με ασφάλεια σπίτι." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "When night fell and the little animals felt scared, Babis led everyone safely home." } }
      }
    },
    "chapter.forestHero.scene0.choice0" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Οδήγησε όλους στο χωριό" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Guide everyone to the village" } }
      }
    },
    "chapter.forestHero.scene1.narration" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Όλο το χωριό πανηγύρισε για τον Μπάμπη, τον Κότσιφα και την Αλεπού — τους δικούς του ήρωες του δάσους!" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The whole village cheered for Babis, Kotsifi and Alepou — the forest's very own heroes!" } }
      }
    },

    "parent.navTitle" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Eltern" } },
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Γονείς" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Parents" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Padres" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Parents" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Genitori" } },
        "pt" : { "stringUnit" : { "state" : "translated", "value" : "Pais" } }
      }
    },
    "parent.gate.title" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Elternkontrolle" } },
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Πύλη Γονέων" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Parental Gate" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Control parental" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Contrôle parental" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Controllo genitori" } },
        "pt" : { "stringUnit" : { "state" : "translated", "value" : "Controlo parental" } }
      }
    },
    "parent.gate.subtitle" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Löse das, um fortzufahren" } },
