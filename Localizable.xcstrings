    "adventure.explore.foxDialogue": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Pst, sei hier vorsichtig! Ich wohne in der Nähe und liebe Besuch.“"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "«Σουτ, πρόσεχε εδώ μέσα! Μένω εδώ κοντά και μου αρέσουν οι επισκέπτες.»"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Shh, careful in here! I live nearby and I love visitors.\""
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Shh, ¡cuidado aquí dentro! Vivo cerca y me encantan las visitas.»"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Chut, fais attention ici ! J'habite tout près et j'adore les visiteurs. »"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Shh, attento qui dentro! Vivo qui vicino e adoro le visite.»"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "«Shh, cuidado aqui dentro! Vivo perto e adoro visitas.»"
          }
        }
      }
    },
