    "dialogue.village.water": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια σταγόνα καθαρό νερό, που λάμπει στον ήλιο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A clean water drop, sparkling in the sun."
          }
        }
      }
    },
    "dialogue.village.chest.locked": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το σεντούκι δεν ανοίγει ακόμα. Ίσως όταν γεμίσει το καλάθι..."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The chest won't budge yet. Maybe once the basket is full..."
          }
        }
      }
    },
    "dialogue.village.chest.approach0": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κοίτα, Μπάμπη! Ένα σεντούκι — αλλά έχει κλειδαριά-γρίφο!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look, Babis! A chest — but it has a puzzle lock!"
          }
        }
      }
    },
    "dialogue.village.chest.approach1": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ας το λύσουμε μαζί και ας δούμε τι κρύβει μέσα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let's solve it together and see what's inside."
          }
        }
      }
    },
    "dialogue.village.chest.opened": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το σεντούκι είναι άδειο τώρα — αλλά τι θησαυρό μας έδωσε!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The chest is empty now — but what a treasure it gave us!"
          }
        }
      }
    },
    "dialogue.village.chest.reward": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Υπέροχα! Έλυσες τον γρίφο και άνοιξες το σεντούκι!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wonderful! You solved the puzzle and opened the chest!"
          }
        }
      }
    },
